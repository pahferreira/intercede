{
	"name": "@intercede/api",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts"
		},
		"./testing": "./src/app.ts"
	},
	"scripts": {
		"dev": "bun --watch src/dev.ts",
		"build": "bun build src/handlers/api.ts src/handlers/sweeper.ts --target=node --format=esm --minify --sourcemap=linked --outdir=dist --entry-naming=[name].mjs",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.18",
		"postgres": "^4.1.1"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11"
	}
}
