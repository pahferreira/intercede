{
	"name": "@intercede/api",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts"
		},
		"./testing": "./src/app.ts"
	},
	"scripts": {
		"dev": "bun --watch src/dev.ts",
		"build": "bun build src/handlers/api.ts src/handlers/sweeper.ts --target=node --format=esm --minify --sourcemap=linked --outdir=dist --entry-naming=[name].mjs",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^1.1.2",
		"@anthropic-ai/sdk": "^1.9.0",
		"@aws-sdk/client-bedrock-runtime": "^3.1170.0",
		"@hono/zod-validator": "^0.9.1",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.18",
		"postgres": "^4.1.1",
		"posthog-node": "^5.74.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11"
	}
}
