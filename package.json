{
	"name": "intercede",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"prepare": "husky",
		"lint": "biome check . && bun run --filter @intercede/web lint:classes",
		"lint:deps": "depcruise apps/api/src apps/api/evals --config .dependency-cruiser.cjs",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"eval:search": "bun run --cwd apps/api eval:search",
		"db:migrate": "bun run --filter @intercede/api db:migrate"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@swc/core": "^1.16.22",
		"@types/bun": "^1.4.4",
		"dependency-cruiser": "^18.7.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"typescript": "^7.0.2"
	}
}
